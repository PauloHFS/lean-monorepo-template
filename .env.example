# =============================================================================
# Lean Monorepo — environment template
# Copie para .env (NÃO comite) e ajuste conforme o ambiente.
# =============================================================================

# ---------- Geral ----------
APP_ENV=local                # local | staging | prod
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ---------- API ----------
API_PORT=8000
WEB_ORIGIN=http://localhost:5173   # CORS do dev server do Vite
# SPA_DIST_PATH é ancorado a apps/api/app/main.py por padrão.
# Em Docker, o compose sobrescreve para /app/apps/web/dist.

# ---------- Banco (Postgres) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# DSN completa (sobrescreve os campos acima se setada):
# DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ---------- Auth / Sessões ----------
# Gere com: openssl rand -hex 32
SECRET_KEY=change-me-please-32-bytes-minimum-aaaaaaaaaaaaaaaaaaaa
SESSION_COOKIE_NAME=lm_session
SESSION_TTL_SECONDS=2592000     # 30 dias
COOKIE_SECURE=false             # true em prod (HTTPS)
COOKIE_SAMESITE=lax             # lax | strict | none
PASSWORD_MIN_LENGTH=8

# ---------- Worker / Filas ----------
WORKER_POLL_INTERVAL_MS=500
WORKER_BATCH_SIZE=5
WORKER_VISIBILITY_TIMEOUT_S=300

# ---------- Backup (R2 via rclone) ----------
RCLONE_REMOTE_NAME=r2
RCLONE_BUCKET=lean-monorepo-backups
RCLONE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_KEEP_DAYS=14

# ---------- Email transacional (SMTP-first) ----------
# EMAIL_PROVIDER=smtp    → default. SMTP genérico (Mailpit dev, Resend/SES/Postmark prod).
# EMAIL_PROVIDER=logging → só loga (CI/tests).
EMAIL_PROVIDER=smtp
EMAIL_FROM="App <noreply@example.com>"

# --- Dev local (Mailpit sobe junto no compose) ---
SMTP_HOST=mailpit
SMTP_PORT=1025

# --- Prod: Resend via SMTP (host=smtp.resend.com, port=465=TLS implícito) ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SSL=true
# SMTP_USER=resend
# SMTP_PASSWORD=${RESEND_API_KEY}

# --- Prod genérico (ex.: AWS SES com STARTTLS na 587) ---
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=AKIAxxxxxx
# SMTP_PASSWORD=<smtp-password>

# --- Provedores SMTP populares ---
#   Resend:   smtp.resend.com:465 (SSL) — user=resend, password=<API_KEY>
#   Postmark: smtp.postmarkapp.com:587 (STARTTLS) — user=<server-token>, password=<server-token>
#   Mailgun:  smtp.mailgun.org:587 (STARTTLS) — user=postmaster@<domain>, password=<pass>
#   SES:      email-smtp.<region>.amazonaws.com:587 (STARTTLS)
#   Brevo:    smtp-relay.brevo.com:587 (STARTTLS)
#   Mailjet:  in-v3.mailjet.com:587 (STARTTLS)

# ---------- Observability ----------
# App emite OTLP quando esta var está setada. Deixe vazia em dev local.
# Use http://otel-collector:4317 dentro do profile `observability`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Sentry (error tracking). Opcional. Deixe vazia pra desligar.
# SENTRY_DSN=https://...@sentry.io/...