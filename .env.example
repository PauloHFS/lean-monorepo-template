# ---------- Backend / API ----------
# APP_ENV: local | staging | prod. Em prod o boot falha se SECRET_KEY ainda for
# o default (ou tiver <32 chars), COOKIE_SECURE=false ou WEB_ORIGIN não for https.
APP_ENV=local
SECRET_KEY=
COOKIE_SECURE=false              # true obrigatório em prod
COOKIE_SAMESITE=lax              # lax | strict | none
WEB_ORIGIN=http://localhost:5173 # https obrigatório em prod
SESSION_TTL_SECONDS=2592000
PASSWORD_MIN_LENGTH=8
# DSN completa; quando definida, sobrepõe os POSTGRES_* acima.
DATABASE_URL=
# DSN do pooler (pgbouncer) usada SÓ pela API. Vazio = a API fala direto no
# Postgres (comportamento padrão). No compose, ligue com:
#   DATABASE_URL_POOLER=postgresql+asyncpg://app:app@pgbouncer:6432/app
# (troque user/senha se POSTGRES_USER/POSTGRES_PASSWORD não forem os defaults).
# NÃO acrescente ?sslmode=require: o pgbouncer local não tem certificado TLS e
# DB_SSLMODE não é aplicado a este DSN. Worker e migrate continuam diretos.
DATABASE_URL_POOLER=
# Anexado à DSN direta quando definido (ex.: require). Vazio = sem sslmode.
# Nunca é aplicado ao DATABASE_URL_POOLER.
DB_SSLMODE=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
# IPs/redes do proxy confiável para X-Forwarded-For. NUNCA "*" em prod:
# qualquer cliente forja o IP e ganha um bucket novo de rate limit.
# O uvicorn confia no XFF do peer e caminha da direita para a esquerda,
# devolvendo o primeiro IP NÃO confiável — então o proxy precisa ANEXAR o IP
# real (nunca repassar o XFF cru do cliente); com "*" o uvicorn devolveria o
# item mais à esquerda (forjável).
#   - proxy em loopback (Caddy/nginx na mesma máquina): 127.0.0.1
#   - Coolify (Traefik em container na rede do recurso, IP não estável):
#     172.16.0.0/12 (cobre os pools padrão do Docker)
#   - Cloudflare Tunnel na frente do Coolify: 127.0.0.1 (o cloudflared
#     conecta via loopback)
FORWARDED_ALLOW_IPS=127.0.0.1

# ---------- Email transacional ----------
# SMTP universal: Mailpit (dev), Resend, SES, Postmark, Mailgun, Brevo (todos aceitam SMTP).
# Resend:    smtp.resend.com:465, user=resend, password=API key (SMTP_SSL=true)
# SES:       email-smtp.<region>.amazonaws.com:587, STARTTLS (SMTP_STARTTLS=true)
# Postmark:  smtp.postmarkapp.com:587, STARTTLS
# Mailgun:   smtp.mailgun.org:587, STARTTLS
# Brevo:     smtp-relay.brevo.com:587, STARTTLS
# Dev local: Mailpit no compose (porta 1025, sem TLS)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false          # true p/ porta 465 (Resend)
SMTP_STARTTLS=false     # true p/ porta 587 (SES, Postmark, Mailgun, Brevo)
EMAIL_FROM="App <noreply@example.com>"
# EMAIL_LOG_ONLY=true   # true = só loga, não envia (debug/staging/CI)

# ---------- Postgres / backup (host) ----------
# Usados por scripts/backup.sh, scripts/restore.sh e scripts/test-restore.sh.
# backup.sh/restore.sh rodam no HOST (exigem pg_dump/pg_restore/psql); `just test-restore` roda em container.
# Trate como segredos: nunca versione valores reais (deixe vazio e exporte no host).
# POSTGRES_CONTAINER=postgres muda backup.sh/restore.sh para o MODO CONTAINER:
# o pg_dump/pg_restore roda dentro do container do Postgres (docker compose exec -T),
# então não precisa de porta publicada nem de client no host. Vazio = modo host.
POSTGRES_CONTAINER=
# Compose usado no modo container. Default: <repo>/docker-compose.yml.
# No deploy do Coolify, aponte para o compose efetivamente implantado.
BACKUP_COMPOSE_FILE=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
# Default do compose é "app" (dev); troque em qualquer ambiente real.
# App e banco usam o MESMO valor (o compose replica o default para os dois):
# senha vazia aqui deixa o app com DSN sem senha e o banco exigindo senha.
POSTGRES_PASSWORD=app
# Tuning do Postgres (aplicado no `command:` do serviço postgres do compose).
# Estes dois dependem da RAM do host — tabela por faixa em docs/tuning.md §2.
# Default: 1GB/3GB (vale de 2GB para cima). Na VPS de 8GB do repo: 2GB/6GB.
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
# Destino remoto via rclone. Vazio = modo local: o dump fica em BACKUP_DIR.
# Nunca escreva aqui o nome real do bucket num arquivo versionado.
RCLONE_BUCKET=
RCLONE_REMOTE_NAME=r2
BACKUP_KEEP_DAYS=14
BACKUP_DIR=/tmp/lean-monorepo-backups
TZ=UTC

# ---------- Observability (opcional) ----------
# Sem OTEL_EXPORTER_OTLP_ENDPOINT, tracing é no-op (Sentry segue via SENTRY_DSN).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_TRACES_SAMPLER=parentbased_traceidratio  # always_on | always_off | traceidratio | parentbased_traceidratio
# OTEL_SAMPLE_RATIO=1.0                        # usado por traceidratio/parentbased_traceidratio
#                                              # (alias: OTEL_TRACES_SAMPLER_ARG)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=1.0

# ---------- Grafana (profile observability) ----------
# Senha do admin (user admin). Defina antes do 1º `just up-obs`.
# O Grafana 11.3.1 ignora esta var vazia e usa o default "admin"/"admin"; defina um valor.
GRAFANA_ADMIN_PASSWORD=
